# Load only into the Relay process/container. Fill device path on the target host.
# No tokens belong in this file. Settings are startup-only; restart clears temporary state.
Relay__DeviceFile=/run/secrets/devices.json
Relay__RetentionSeconds=1800
Relay__IdempotencyRetentionSeconds=1800
Relay__IdempotencyMaxEntries=512
Relay__MaxTextUtf8Bytes=1000000
Relay__MaxTextJsonBytes=8000000
Relay__MaxImageBytes=20000000
Relay__MaxDecodedPixels=64000000
Relay__MaxUploads=2
Relay__MaxDownloads=4
Relay__MaxWebSockets=16
Relay__UploadTimeoutSeconds=30
Relay__DownloadTimeoutSeconds=30
Relay__MemoryBudgetBytes=512000000
